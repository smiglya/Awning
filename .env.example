# Copy to .env and fill in when the backend exists.
# While VITE_API_BASE_URL is empty the whole site runs on local storage —
# see src/api/endpoints.ts for the routes the server must expose.

# Backend origin. Include the port if it is not 80/443.
VITE_API_BASE_URL=

# Examples:
# VITE_API_BASE_URL=http://localhost:8080
# VITE_API_BASE_URL=https://api.awning.nyc

# Request timeout in milliseconds (default 12000)
VITE_API_TIMEOUT_MS=12000

# Absolute origin, used for canonical, og:url and sitemap.xml.
# Leave empty locally; set it per deploy target.
# VITE_SITE_URL=https://awning.nyc
VITE_SITE_URL=

# Subdirectory the site is served from. Read by vite.config.ts, and everything
# downstream — asset URLs, prerendered links, router matching — derives from it.
#   /          own domain (default)
#   /Awning/   GitHub Pages project site
VITE_BASE=/

# 'true' keeps a deploy out of search results. Required on any temporary URL:
# once the real domain is live the two would compete as duplicate content, and
# the preview is the one with the older signals. Set by the Pages workflow.
VITE_NOINDEX=
